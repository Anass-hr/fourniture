# Variables à définir pour le déploiement cloud (Supabase + Vercel).
# NE JAMAIS committer le vrai fichier .env (déjà dans .gitignore).

# Supabase → Project Settings → Database → Connection string
#   - DATABASE_URL : "Connection pooling" (Transaction), port 6543, ajouter ?pgbouncer=true
#   - DIRECT_URL   : "Direct connection", port 5432 (utilisée pour les migrations)
DATABASE_URL="postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

# Secret de signature des jetons de connexion (mettre une longue chaîne aléatoire)
JWT_SECRET="remplacer-par-une-longue-chaine-aleatoire"

# Compte admin initial (utilisé seulement si la base est vide)
ADMIN_EMAIL="anas@strapexmaroc.com"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="Administrateur"
