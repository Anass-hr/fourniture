generator client {
  provider = "prisma-client-js"
  // "native" pour le PC local ; "rhel-openssl-3.0.x" pour l'exécution sur Vercel.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// ─── SUPABASE (PostgreSQL) ──────────────────────────────────────
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooler transaction (6543, pgbouncer)
  directUrl = env("DIRECT_URL")   // pooler session (5432) — migrations
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("STAFF") // ADMIN | STAFF
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  purchases Purchase[]
  issues    Issue[]
}

model Person {
  id         Int      @id @default(autoincrement())
  name       String
  department String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  issues Issue[]
}

model Item {
  id           Int      @id @default(autoincrement())
  name         String
  category     String   @default("AUTRE") // FOURNITURE | PAPETERIE | INFORMATIQUE | NETTOYAGE | CUISINE | AUTRE
  unit         String   @default("pièce")
  minThreshold Int      @default(0)
  location     String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  purchases Purchase[]
  issues    Issue[]
}

model Purchase {
  id          Int      @id @default(autoincrement())
  itemId      Int
  item        Item     @relation(fields: [itemId], references: [id])
  quantity    Int
  unitPrice   Float?
  supplier    String?
  orderedBy   String?
  note        String?
  date        DateTime @default(now())
  createdById Int?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

model Issue {
  id          Int      @id @default(autoincrement())
  itemId      Int
  item        Item     @relation(fields: [itemId], references: [id])
  quantity    Int
  personId    Int?
  person      Person?  @relation(fields: [personId], references: [id])
  note        String?
  date        DateTime @default(now())
  createdById Int?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}
